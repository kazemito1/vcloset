# ==========================================
# V.CLOSET - Variáveis de Ambiente (exemplo)
# Copie este arquivo para .env e preencha com chaves de TESTE/SANDBOX.
# NUNCA coloque credenciais reais em produção neste arquivo.
# ==========================================

# Banco de dados (SQLite para desenvolvimento local)
DATABASE_URL="file:./dev.db"

# Stripe (modo teste - obtenha em https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Mercado Pago (modo sandbox - obtenha em https://www.mercadopago.com.br/developers/panel)
MERCADOPAGO_ACCESS_TOKEN="TEST-..."
MERCADOPAGO_PUBLIC_KEY="TEST-..."

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_STORE_NAME="V.CLOSET"

# Painel Admin (autenticação simples por senha fixa via cookie assinado)
ADMIN_PASSWORD="troque-esta-senha"
ADMIN_SECRET="troque-este-segredo-aleatorio"

# Painel de Leads independente (/painel) — login exclusivo do painel de leads
PANEL_EMAIL="admin@exemplo.com"
PANEL_PASSWORD="troque-esta-senha"

# E-mail transacional (Resend) — confirmação do checkout
# Chave em https://resend.com/api-keys · EMAIL_FROM exige domínio verificado no Resend
RESEND_API_KEY="re_..."
EMAIL_FROM="V.CLOSET <no-reply@vcllosetstore.com.br>"
